{
  "name": "@flowmind/agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../.env ../node_modules/tsx/dist/cli.mjs watch --tsconfig tsconfig.dev.json src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@flowmind/agent-contracts": "0.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.17.1",
    "better-sqlite3": "12.2.0",
    "diff": "8.0.4",
    "minimatch": "10.2.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
