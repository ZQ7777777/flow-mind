AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=3100
AGENT_DATA_DIR=../data/agent-web
# Windows 使用分号分隔多个允许根目录；目标 business-base 必须位于其中。
AGENT_ALLOWED_TARGET_ROOTS=E:\business-workspace
FLOW_PLATFORM_BASE_URL=http://127.0.0.1:8080
# PI_MODEL=openai/gpt-5.6-terra
# PI_MODEL=zai/glm-5.2
# PI_MODEL=deepseek/deepseek-v4-flash
PI_MODEL=deepseek/deepseek-v4-pro
# Fill in your OpenAI API key after copying this file to .env. Do not commit .env.
OPENAI_API_KEY=
PI_THINKING_LEVEL=medium
# 缺省复用 PI_MODEL；可指定独立的低成本摘要模型。
PI_COMPACTION_MODEL=
# Tests and local deterministic acceptance only. Never enable in production.
AGENT_FAKE_PI=false
