AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=3100
AGENT_DATA_DIR=../data/agent-web
# Windows 使用分号分隔多个允许根目录；目标 business-base 必须位于其中。
AGENT_ALLOWED_TARGET_ROOTS=xxxxxx\business-base
BUSINESS_BASE_FRONTEND_URL=http://127.0.0.1:5174
# Java 质量门禁使用的稳定 Maven 本地仓库；启动脚本默认使用仓库根 .m2/repository。
# AGENT_MAVEN_REPO_LOCAL=D:\flow-platform\flow-mind\.m2\repository
FLOW_PLATFORM_BASE_URL=http://127.0.0.1:8081
FLOW_PLATFORM_AUTH_MODE=session


PI_CODING_AGENT_DIR=../.pi-agent
PI_THINKING_LEVEL=medium
# PI_MODEL=sub2api/gpt-5.6-terra
# PI_MODEL=zai/glm-5.2
# PI_MODEL=deepseek/deepseek-v4-flash
# PI_MODEL=deepseek/deepseek-v4-pro
PI_MODEL=sub2api/glm-5.2
# Standard modules use the zero-cost deterministic IR generator by default.
# Set PI_LEGACY only when a separately authorized real-model experiment is required.
AGENT_GENERATION_STRATEGY=DETERMINISTIC_IR_V1
# RAG release: SHADOW -> CANARY -> HYBRID_DEFAULT. BM25_ONLY or force=true is the immediate rollback path.
AGENT_RAG_RELEASE_MODE=SHADOW
AGENT_RAG_CANARY_PERCENT=10
AGENT_RAG_POLICY_VERSION=RAG_RELEASE_V1
AGENT_RAG_FORCE_BM25=false
# Typed case/relationship index rollout. DEFAULT makes the deterministic recipe selector consume v2.
AGENT_RAG_V2_MODE=SHADOW
# One-time CNY budget. Real calls remain fail-closed until a scoped authorization exists.
AGENT_MODEL_BUDGET_CNY=10
AGENT_MODEL_BUDGET_LOCKED=true
# Required before any real call; zero or an unversioned price disables paid calls.
AGENT_MODEL_INPUT_CNY_PER_MILLION=0
AGENT_MODEL_OUTPUT_CNY_PER_MILLION=0
AGENT_MODEL_PRICE_VERSION=UNCONFIGURED
AGENT_MODEL_MAX_OUTPUT_TOKENS=1024
OPENAI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
# Tests and local deterministic acceptance only. Never enable in production.
AGENT_FAKE_PI=false
# 10 元预算模式禁用模型自动压缩；该值仅为兼容保留。
PI_COMPACTION_MODEL=
